# finanzas-pareja — variables de entorno (plantilla)
#
# 1) Copia este archivo a .env.local  (cp .env.example .env.local)
# 2) Rellena los dos valores con los de tu proyecto Supabase:
#      Supabase → Project Settings → API
#        - Project URL        -> VITE_SUPABASE_URL
#        - Project API keys → anon public  -> VITE_SUPABASE_ANON_KEY
#
# .env.local está en .gitignore: NUNCA se sube al repo.
# La clave "service_role" NO se usa en el frontend; no la pongas aquí.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
